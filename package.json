{
    "name": "tp2-laravel",
    "version": "0.1.0",
    "private": true,
    "homepage": "https://aya07-code.github.io/tp2-laravel",
    "dependencies": {
      "laravel-mix": "^6.0.0",
      "lodash": "^4.17.19",
      "resolve-url-loader": "^3.1.0",
      "sass": "^1.32.11",
      "sass-loader": "^11.0.1"
    },
    "devDependencies": {
      "axios": "^0.21",
